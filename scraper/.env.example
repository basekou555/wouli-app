# Copier ce fichier en .env et remplir les valeurs

# Instagram
INSTAGRAM_USERNAME=ton_compte_instagram
INSTAGRAM_PASSWORD=ton_mot_de_passe

# Supabase
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...

# Options scraper
TEST_MODE=false
HEADLESS=false
AUTO_ENHANCE=false
FILTERING_MODE=balanced

# UUID admin Supabase (profiles.id de ton compte admin)
SUPABASE_ADMIN_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
